{
  "name": "bb-plugin-activity-list",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.140",
    "node": ">=22.18"
  },
  "bb": {
    "name": "Activity list",
    "description": "bb's sidebar thread list, sorted by activity, with colored status cues for threads that need input, run, fail, or have unread results.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@get-bb/plugin-sdk": "0.6.140",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
